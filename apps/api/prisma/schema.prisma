// WoodFlow — Yog'och & Taxta biznes platformasi
// Prisma schema · PostgreSQL
// Muallif: Adam (Juraev Otabek)
//
// Asosiy prinsiplar:
//  - Ombor baza birligi = m³ (kub).  Narx baza valyutasi = UZS (so'm).
//  - RUB faqat importda (kirim kursi muzlatiladi), USD faqat to'lovda.
//  - Har yozuvda workspaceId → 2 biznes toza ajraladi (Prisma middleware filtri).
//  - Immutable ledger: pul harakati o'chirilmaydi, faqat storno.
//  - Pul qiymatlar Decimal(18,2), kub Decimal(12,4), kurs Decimal(14,6).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum WorkspaceType {
  WOOD_TRADING // 1-biznes · Yog'och sotuvi
  LUMBER_PRODUCTION // 2-biznes · Taxta sotuvi
}

enum Role {
  OWNER // egasi — hamma narsa + konsolidatsiya
  ADMIN // administrator — RoleGuard darajasi
  AGENT // agent/menejer — RoleGuard darajasi
  MANAGER
  WORKER // ishchi — faqat AuthGuard darajasi
}

enum SupplierType {
  RUSSIA
  LOCAL
}

enum PurchaseSource {
  RUSSIA_IMPORT // furaga bog'liq, valyuta RUB, kurs muzlatiladi
  LOCAL_WHOLESALE // furasiz, valyuta UZS
  INTERNAL_TRANSFER // 1-biznesdan ichki transfer (2-biznesga xarajat)
}

enum Currency {
  UZS
  RUB
  USD
}

enum SaleType {
  PER_CUBE // furada kub bilan
  PER_PIECE // donaga
  WHOLESALE // ulgurji
}

enum ExpenseCategory {
  SALARY
  GAS
  ELECTRICITY
  WATER
  TAX
  EQUIPMENT
  FOOD
  TRANSPORT
  OTHER
}

enum SalaryType {
  MONTHLY
  DAILY
  PER_PIECE
}

enum LedgerEntryType {
  PURCHASE // kirim (chiqim pul / tannarx)
  SALE // savdo (kirim pul)
  PAYMENT // to'lov qabuli
  EXPENSE // xarajat
  SALARY_PAYMENT // oylik
  TRANSFER_IN // ichki transfer — daromad (1-biznes)
  TRANSFER_OUT // ichki transfer — xarajat (2-biznes)
  DEFECT_LOSS // nuqson zarari
}

enum LotStatus {
  AVAILABLE // Mavjud
  LOW // Kam qolgan
  RESERVED // Bron qilingan
  SOLD_OUT // Tugagan
  DEFECT // Nuqson lot
}

// ──────────────────── MULTI-TENANCY / USERS ───────────────────

// Platforma darajasidagi rol: CEO — faqat bitta (Adam), qolganlar USER.
enum PlatformRole {
  CEO
  USER
}

enum BusinessStatus {
  PENDING // CEO tasdig'ini kutmoqda
  ACTIVE
  REJECTED
}

// Biznes turi — qaysi makon(lar) ochiladi.
enum BusinessKind {
  WOOD_ONLY // faqat Yog'och sotuvi
  LUMBER_ONLY // faqat Taxta sotuvi
  BOTH // ikkalasi (ichki transfer mavjud)
}

enum JoinRequestType {
  OWNER_SIGNUP // yangi biznes egasi — CEO tasdiqlaydi
  WORKER_JOIN // ishchi kirishi — biznes egasi tasdiqlaydi
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// Oylik tasdig'i: owner to'ladi (PENDING) → ishchi qabul qildi (CONFIRMED).
enum SalaryStatus {
  PENDING
  CONFIRMED
}

model User {
  id           String       @id @default(cuid())
  name         String
  phone        String       @unique
  email        String?      @unique
  passwordHash String
  platformRole PlatformRole @default(USER)
  memberships  Membership[]
  ownedBusinesses Business[] @relation("BusinessOwner")
  joinRequests JoinRequest[] @relation("Requester")
  decidedRequests JoinRequest[] @relation("Decider")
  employeeLinks Employee[]
  notifications Notification[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
}

// Ilova ichidagi bildirishnomalar — rolga bog'langan, o'qilgan/o'qilmagan.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String // OWNER_REQUEST | PAYMENT_SUBMITTED | PAYMENT_DECIDED | SALARY_PAID ...
  title     String
  body      String?
  link      String? // bosilganda o'tadigan sahifa
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, read])
  @@index([userId, createdAt])
}

// Biznes — owner'ning brendi: nom + logo. Ikkala workspace shu ostida.
model Business {
  id        String         @id @default(cuid())
  name      String
  logoUrl   String?
  ownerId   String
  status    BusinessStatus @default(PENDING)
  kind      BusinessKind   @default(BOTH)

  // Platforma obunasi: paidUntil'gacha ochiq; freeAccess = CEO tekin ruxsat bergan
  paidUntil  DateTime?
  freeAccess Boolean   @default(false)

  owner            User              @relation("BusinessOwner", fields: [ownerId], references: [id])
  workspaces       Workspace[]
  joinRequests     JoinRequest[]
  employees        Employee[]
  platformPayments PlatformPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
}

// Owner platformaga to'lovi — CEO tasdiqlaydi, biznes muddatini uzaytiradi.
model PlatformPayment {
  id          String        @id @default(cuid())
  businessId  String
  amountUzs   Decimal       @db.Decimal(18, 2)
  months      Int           @default(1) // necha oyga
  note        String?
  receiptUrl  String? // chek rasmi (ixtiyoriy)
  status      RequestStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?

  business Business @relation(fields: [businessId], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, status])
}

// Tasdiqlash so'rovlari: OWNER_SIGNUP → CEO; WORKER_JOIN → biznes egasi.
model JoinRequest {
  id         String          @id @default(cuid())
  type       JoinRequestType
  userId     String
  businessId String
  employeeId String? // WORKER_JOIN'da mos kelgan ishchi yozuvi
  status     RequestStatus   @default(PENDING)
  decidedById String?
  decidedAt  DateTime?

  user      User      @relation("Requester", fields: [userId], references: [id])
  business  Business  @relation(fields: [businessId], references: [id])
  employee  Employee? @relation(fields: [employeeId], references: [id])
  decidedBy User?     @relation("Decider", fields: [decidedById], references: [id])

  createdAt DateTime @default(now())

  @@index([businessId, status])
  @@index([userId])
}

model Workspace {
  id           String        @id @default(cuid())
  name         String
  type         WorkspaceType
  baseCurrency Currency      @default(UZS)
  businessId   String?

  business Business? @relation(fields: [businessId], references: [id])

  memberships       Membership[]
  suppliers         Supplier[]
  customers         Customer[]
  shipments         Shipment[]
  purchases         Purchase[]
  inventoryLots     InventoryLot[]
  sales             Sale[]
  expenses          Expense[]
  employees         Employee[]
  productTemplates  ProductTemplate[]
  productionBatches ProductionBatch[]
  finishedGoods     FinishedGoodsLot[]
  ledgerEntries     LedgerEntry[]
  transfersOut      StockTransfer[]    @relation("TransferFrom")
  transfersIn       StockTransfer[]    @relation("TransferTo")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id          String @id @default(cuid())
  userId      String
  workspaceId String
  role        Role   @default(WORKER)

  user      User      @relation(fields: [userId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// ───────────────────────── KONTRAGENTLAR ──────────────────────

model Supplier {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  phone       String?
  type        SupplierType

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  purchases Purchase[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model Customer {
  id          String  @id @default(cuid())
  workspaceId String
  name        String
  phone       String?

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  sales     Sale[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// ─────────────────── KIRIM: FURA + PURCHASE ───────────────────

model Shipment {
  id            String   @id @default(cuid())
  workspaceId   String
  truckNumber   String // nomer, masalan AA777BB
  truckColor    String? // rang
  ownerName     String
  ownerPhone    String?
  arrivalDate   DateTime
  transportCost Decimal  @default(0) @db.Decimal(18, 2) // so'mda
  customsCost   Decimal  @default(0) @db.Decimal(18, 2) // bojxona, so'mda

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  purchases Purchase[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model Purchase {
  id           String         @id @default(cuid())
  workspaceId  String
  source       PurchaseSource
  shipmentId   String? // RUSSIA_IMPORT da to'ladi
  supplierId   String?
  woodType     String // Qarag'ay, Terak, Qayin...
  grade        String // 1-nav, 2-nav...
  volumeM3     Decimal        @db.Decimal(12, 4)
  quantity     Int? // dona soni (ixtiyoriy)
  unitPrice    Decimal        @db.Decimal(18, 2) // asl valyutada (RUB yoki UZS)
  currency     Currency // RUB | UZS
  exchangeRate Decimal        @default(1) @db.Decimal(14, 6) // kirim kunida muzlatiladi
  totalCostUzs Decimal        @db.Decimal(18, 2) // so'mga aylantirilgan jami tannarx
  date         DateTime

  workspace Workspace     @relation(fields: [workspaceId], references: [id])
  shipment  Shipment?     @relation(fields: [shipmentId], references: [id])
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  lot       InventoryLot? // stock hosil qiladi (1:1)

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([shipmentId])
}

// ─────────────────────── OMBOR + NUQSON ───────────────────────

model InventoryLot {
  id                String    @id @default(cuid())
  workspaceId       String
  purchaseId        String    @unique
  woodType          String
  grade             String
  volumeM3Remaining Decimal   @db.Decimal(12, 4) // sotiladigan qoldiq
  quantityRemaining Int? // qoldiq dona (kirimda kiritilgan bo'lsa)
  unitCostUzsPerM3  Decimal   @db.Decimal(18, 2) // tannarx / m³
  status            LotStatus @default(AVAILABLE)

  workspace         Workspace         @relation(fields: [workspaceId], references: [id])
  purchase          Purchase          @relation(fields: [purchaseId], references: [id])
  defects           DefectRecord[]
  saleItems         SaleItem[]
  transfers         StockTransfer[]
  productionBatches ProductionBatch[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
}

model DefectRecord {
  id       String   @id @default(cuid())
  lotId    String
  volumeM3 Decimal  @db.Decimal(12, 4) // qoldiqdan minus qilinadi
  quantity Int? // nuqson dona (ixtiyoriy)
  reason   String?
  date     DateTime

  lot InventoryLot @relation(fields: [lotId], references: [id])

  createdAt DateTime @default(now())

  @@index([lotId])
}

// ───────────────────────── SAVDO + TO'LOV ─────────────────────

model Sale {
  id            String   @id @default(cuid())
  workspaceId   String
  customerId    String?
  saleType      SaleType
  totalPriceUzs Decimal  @db.Decimal(18, 2) // narx doim so'mda
  date          DateTime

  workspace Workspace  @relation(fields: [workspaceId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])
  items     SaleItem[]
  payments  Payment[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([customerId])
}

model SaleItem {
  id            String   @id @default(cuid())
  saleId        String
  lotId         String? // xomashyo lot (Yog'och) — o'lchamli savdo
  finishedLotId String? // tayyor mahsulot lot (Taxta) — dona savdosi
  quantity      Int // dona soni
  length        Decimal? @db.Decimal(8, 3) // m (tayyor mahsulotda null)
  width         Decimal? @db.Decimal(8, 3) // m (taxta eni)
  thickness     Decimal? @db.Decimal(8, 3) // m (taxta qalinligi)
  baseDiamCm    Decimal? @db.Decimal(6, 2) // yumaloq yog'och bosh diametri (sm)
  topDiamCm     Decimal? @db.Decimal(6, 2) // yumaloq yog'och uch diametri (sm)
  volumeM3      Decimal  @db.Decimal(12, 4) // kub: L×W×T×qty; yumaloq: frustum×qty
  unitPriceUzs  Decimal  @db.Decimal(18, 2)
  lineTotalUzs  Decimal  @db.Decimal(18, 2)

  sale        Sale              @relation(fields: [saleId], references: [id])
  lot         InventoryLot?     @relation(fields: [lotId], references: [id])
  finishedLot FinishedGoodsLot? @relation(fields: [finishedLotId], references: [id])

  @@index([saleId])
  @@index([lotId])
  @@index([finishedLotId])
}

model Payment {
  id           String   @id @default(cuid())
  saleId       String
  amount       Decimal  @db.Decimal(18, 2) // asl valyutada
  currency     Currency // UZS | USD
  exchangeRate Decimal  @default(1) @db.Decimal(14, 6) // qabul kunida
  amountUzs    Decimal  @db.Decimal(18, 2) // so'mga aylantirilgan
  date         DateTime

  sale Sale @relation(fields: [saleId], references: [id])

  createdAt DateTime @default(now())

  @@index([saleId])
}

// ────────────── ISHLAB CHIQARISH + ICHKI TRANSFER ─────────────

model ProductTemplate {
  id             String  @id @default(cuid())
  workspaceId    String
  name           String // Pol taxta, Rika...
  length         Decimal @db.Decimal(8, 3)
  width          Decimal @db.Decimal(8, 3)
  thickness      Decimal @db.Decimal(8, 3)
  volumePerPiece Decimal @db.Decimal(12, 6) // = L×W×T

  workspace    Workspace          @relation(fields: [workspaceId], references: [id])
  batches      ProductionBatch[]
  finishedLots FinishedGoodsLot[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model ProductionBatch {
  id              String   @id @default(cuid())
  workspaceId     String
  date            DateTime
  inputLotId      String? // xomashyo qaysi lotdan (ombordan yechiladi)
  inputVolumeM3   Decimal  @db.Decimal(12, 4) // xomashyo
  outputProductId String?
  outputQuantity  Int
  yieldPercent    Decimal  @db.Decimal(5, 2) // chiqim %

  workspace     Workspace         @relation(fields: [workspaceId], references: [id])
  inputLot      InventoryLot?     @relation(fields: [inputLotId], references: [id])
  outputProduct ProductTemplate?  @relation(fields: [outputProductId], references: [id])
  finishedLot   FinishedGoodsLot?

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

// Tayyor mahsulot ombori (xomashyo omboridan alohida) — dona hisobida.
model FinishedGoodsLot {
  id                  String  @id @default(cuid())
  workspaceId         String
  productId           String
  batchId             String? @unique
  quantityRemaining   Int
  unitCostUzsPerPiece Decimal @db.Decimal(18, 2) // partiya tannarxi / dona

  workspace Workspace        @relation(fields: [workspaceId], references: [id])
  product   ProductTemplate  @relation(fields: [productId], references: [id])
  batch     ProductionBatch? @relation(fields: [batchId], references: [id])
  saleItems SaleItem[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
}

model StockTransfer {
  id               String   @id @default(cuid())
  fromWorkspaceId  String // 1-biznes (daromad)
  toWorkspaceId    String // 2-biznes (xarajat)
  lotId            String
  volumeM3         Decimal  @db.Decimal(12, 4)
  quantity         Int? // dona (ixtiyoriy)
  internalPriceUzs Decimal  @db.Decimal(18, 2) // ichki narx
  date             DateTime

  fromWorkspace Workspace    @relation("TransferFrom", fields: [fromWorkspaceId], references: [id])
  toWorkspace   Workspace    @relation("TransferTo", fields: [toWorkspaceId], references: [id])
  lot           InventoryLot @relation(fields: [lotId], references: [id])

  createdAt DateTime @default(now())

  @@index([fromWorkspaceId])
  @@index([toWorkspaceId])
  @@index([lotId])
}

// ──────────────────── XARAJAT + ISHCHILAR ─────────────────────

model Expense {
  id          String          @id @default(cuid())
  workspaceId String? // null = umumiy (keyin taqsimlanadi)
  category    ExpenseCategory
  amountUzs   Decimal         @db.Decimal(18, 2)
  date        DateTime
  description String?
  employeeId  String?

  workspace Workspace? @relation(fields: [workspaceId], references: [id])
  employee  Employee?  @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([category])
}

model Employee {
  id           String     @id @default(cuid())
  workspaceId  String? // null = ikkala workspace (bitta biznes ichida)
  businessId   String? // qaysi biznesning ishchisi (worker-match uchun)
  userId       String? // tasdiqlangach bog'lanadigan User hisobi
  name         String
  phone        String?
  position     String?
  salaryAmount Decimal    @db.Decimal(18, 2)
  salaryType   SalaryType @default(MONTHLY)

  workspace      Workspace?      @relation(fields: [workspaceId], references: [id])
  business       Business?       @relation(fields: [businessId], references: [id])
  user           User?           @relation(fields: [userId], references: [id])
  salaryPayments SalaryPayment[]
  expenses       Expense[]
  joinRequests   JoinRequest[]

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([businessId])
  @@index([phone])
}

model SalaryPayment {
  id          String       @id @default(cuid())
  employeeId  String
  amountUzs   Decimal      @db.Decimal(18, 2)
  period      String // masalan "2026-06"
  date        DateTime
  status      SalaryStatus @default(PENDING) // owner to'ladi → ishchi tasdiqlaydi
  confirmedAt DateTime? // ishchi qabul qilgan vaqt

  employee Employee @relation(fields: [employeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([employeeId])
}

// ─────────────────────── LEDGER + KURS ────────────────────────

// Yagona pul oqimi. Immutable: o'chirilmaydi, storno reversedById bilan.
model LedgerEntry {
  id          String          @id @default(cuid())
  workspaceId String
  type        LedgerEntryType
  amountUzs   Decimal         @db.Decimal(18, 2) // + kirim / − chiqim
  date        DateTime
  refType     String? // bog'langan entity turi (Sale, Purchase...)
  refId       String? // bog'langan entity id
  description String?

  // Storno (bekor qilish) — asl yozuv o'chirilmaydi, teskari yozuv qo'shiladi
  reversedById String?      @unique
  reversedBy   LedgerEntry? @relation("Storno", fields: [reversedById], references: [id])
  reverses     LedgerEntry? @relation("Storno")

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([refType, refId])
}

model ExchangeRate {
  id       String   @id @default(cuid())
  date     DateTime @unique @db.Date
  rubToUzs Decimal  @db.Decimal(14, 6)
  usdToUzs Decimal  @db.Decimal(14, 6)

  createdAt DateTime @default(now())
}
