# RS Development — production env (serverda `.env` deb nusxalang, real qiymat qo'ying)
#   cp deploy/.env.prod.example deploy/.env
# Bu fayl (real .env) git'ga TUSHMAYDI.

# Postgres paroli (kuchli, tasodifiy) — serverda yarating:
#   openssl rand -hex 24
DB_PASSWORD=CHANGE_ME_strong_random

# JWT maxfiy kaliti (yangi, prod uchun) — serverda yarating:
#   openssl rand -hex 48
JWT_SECRET=CHANGE_ME_96_hex_chars
