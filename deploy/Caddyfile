# ============================================================
#  RS Development — HTTPS reverse proxy (Caddy)
#  Caddy Let's Encrypt sertifikatini AVTOMATIK oladi va yangilaydi.
#  Domenlarni o'zingiznikiga almashtiring va DNS ni serverga yo'naltiring.
# ============================================================

# ─── Frontend (Next.js, :3010) ───
app.example.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:3010

	# Xavfsizlik sarlavhalari
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

# ─── API (NestJS/GraphQL, :4010) ───
api.example.com {
	encode gzip zstd
	reverse_proxy 127.0.0.1:4010

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		-Server
	}
}
